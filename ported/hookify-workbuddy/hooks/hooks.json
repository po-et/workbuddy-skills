{
  "description": "hookify-workbuddy：用 .local.md 规则文件定义 Hooks，无需改 settings.json。修改自 Anthropic hookify（Apache-2.0）。",
  "hooks": {
    "PreToolUse": [{"hooks": [{"type": "command", "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/pretooluse.py\"", "timeout": 10}]}],
    "PostToolUse": [{"hooks": [{"type": "command", "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/posttooluse.py\"", "timeout": 10}]}],
    "Stop": [{"hooks": [{"type": "command", "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/stop.py\"", "timeout": 10}]}],
    "UserPromptSubmit": [{"hooks": [{"type": "command", "command": "python3 \"${CODEBUDDY_PLUGIN_ROOT}/hooks/userpromptsubmit.py\"", "timeout": 10}]}]
  }
}
